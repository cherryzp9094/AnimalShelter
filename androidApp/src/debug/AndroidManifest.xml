<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 디버그 전용: Android 17(targetSdk 37)은 사설 주소(10.0.2.2 = 에뮬레이터의 호스트) 연결에
         지역 네트워크 권한을 요구한다. 중계 시험(설정 → API 연결 → 중계 서버) 때
         `adb shell pm grant com.cherryzp.animalshelter android.permission.ACCESS_LOCAL_NETWORK`로 준다.
         release에는 이 권한이 없다(앱은 공용 인터넷만 쓴다). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
